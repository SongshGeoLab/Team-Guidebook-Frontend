---
import { LOCALES, DEFAULT_LOCALE, ui, type Lang } from '../i18n/ui';
import { getSiteConfig } from '../utils/siteConfig';

// Derive the current locale from the pathname. Falls back to DEFAULT_LOCALE,
// not a hardcoded 'zh': this used to default to zh while astro.config.mjs
// redirected `/` to `/en/` and DEFAULT_LOCALE said 'en' — three answers to
// "what is the default language".
const pathname = Astro.url?.pathname ?? '/';
const pathSegments = pathname.split('/').filter(Boolean);
const isLocale = (value?: string): value is Lang => LOCALES.includes(value as Lang);
const currentLang: Lang = isLocale(pathSegments[0]) ? pathSegments[0] : DEFAULT_LOCALE;

const site = await getSiteConfig(currentLang);

const withLang = (lang: Lang) => {
  if (isLocale(pathSegments[0])) {
    const segments = [...pathSegments];
    segments[0] = lang;
    return `/${segments.join('/')}${pathname.endsWith('/') ? '/' : ''}`;
  }
  return `/${lang}/`;
};

// Routes are code (they have to match what getStaticPaths actually built);
// labels are translations. site.md may override the whole list, but leaving it
// unset is the safe default — see the `nav` field's note in content.config.ts.
const defaultNav = [
  { label: ui.nav.home[currentLang], href: `/${currentLang}/` },
  { label: ui.nav.research[currentLang], href: `/${currentLang}/research/` },
  { label: ui.nav.publications[currentLang], href: `/${currentLang}/publications/` },
  { label: ui.nav.people[currentLang], href: `/${currentLang}/people/` },
  { label: ui.nav.projects[currentLang], href: `/${currentLang}/projects/` },
  { label: ui.nav.resources[currentLang], href: `/${currentLang}/resources/` },
  { label: ui.nav.news[currentLang], href: `/${currentLang}/news/` },
  { label: ui.nav.library[currentLang], href: `/${currentLang}/library/` },
  { label: ui.nav.about[currentLang], href: `/${currentLang}/about/` }
];
const nav = site.nav ?? defaultNav;
---

<header class="border-b border-gray-200 dark:border-gray-800">
  <div class="container mx-auto px-4 py-4 flex items-center justify-between gap-4">
    <div class="text-lg font-semibold">
      <a href={`/${currentLang}/`} class="hover:opacity-80 transition-opacity">
        {site.name}
      </a>
    </div>

    <!--
      Horizontally scrollable rather than wrapping: seven items at every
      breakpoint used to overflow the viewport on a phone with no way to reach
      the ones past the edge.
    -->
    <nav
      class="flex items-center gap-6 text-sm font-medium overflow-x-auto whitespace-nowrap
             [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      aria-label={ui.shell.mainNav[currentLang]}
    >
      {nav.map((item) => (
        <a
          href={item.href}
          class="text-gray-700 dark:text-gray-200 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3 text-sm">
      <a
        href={`/${currentLang}/search/`}
        class="p-2 rounded hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
        aria-label={ui.shell.search[currentLang]}
        title={ui.shell.search[currentLang]}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-gray-700 dark:text-gray-200"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
      </a>
      <a
        href={withLang('zh')}
        class={`px-3 py-1 rounded ${currentLang === 'zh' ? 'bg-blue-600 text-white' : 'hover:bg-gray-100 dark:hover:bg-gray-800'}`}
      >
        中文
      </a>
      <a
        href={withLang('en')}
        class={`px-3 py-1 rounded ${currentLang === 'en' ? 'bg-blue-600 text-white' : 'hover:bg-gray-100 dark:hover:bg-gray-800'}`}
      >
        EN
      </a>
    </div>
  </div>
</header>


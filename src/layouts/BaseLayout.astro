---
import '../styles/global.css';
import Header from '../components/Header.astro';
import RippleBackground from '../components/react/RippleBackground.tsx';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description = "Lab Website", lang = "zh" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-white dark:bg-slate-900 text-slate-900 dark:text-white min-h-screen flex flex-col overflow-hidden">
    <RippleBackground client:load />
    <div class="relative z-10 flex flex-col min-h-screen">
      <Header />
      <main class="flex-grow container mx-auto px-4 py-8">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>


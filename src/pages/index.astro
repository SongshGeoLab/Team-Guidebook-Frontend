---
// Redirect to default language (zh)
// In a real production app, you might check Accept-Language header here
return Astro.redirect('/zh/');
---

<!doctype html>
<html lang="zh">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content="0;url=/zh/" />
    <title>Redirecting...</title>
  </head>
  <body>
    <p>Redirecting to <a href="/zh/">/zh/</a>...</p>
  </body>
</html>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { HomePage } from '../../components/react/pages/HomePage';

const allNews = await getCollection('news', ({ data }) => data.publish !== false);
const newsItems = allNews
  .sort((a, b) => {
    const dateA = a.data.date instanceof Date ? a.data.date : new Date(a.data.date);
    const dateB = b.data.date instanceof Date ? b.data.date : new Date(b.data.date);
    return dateB.getTime() - dateA.getTime();
  })
  .slice(0, 5)
  .map((item) => ({
    id: item.id,
    date: (item.data.date instanceof Date ? item.data.date : new Date(item.data.date)).toISOString(),
    title: item.data.title || item.id,
    content: item.data.content || '',
    tags: item.data.tags || [],
    related_people: item.data.related_people || []
  }));

const allProjects = await getCollection('projects', ({ data }) => data.publish !== false);
const featuredProjects = allProjects
  .sort((a, b) => {
    const dateA = a.data.start_date instanceof Date ? a.data.start_date : new Date(a.data.start_date);
    const dateB = b.data.start_date instanceof Date ? b.data.start_date : new Date(b.data.start_date);
    return dateB.getTime() - dateA.getTime();
  })
  .slice(0, 3)
  .map((project) => ({
    id: project.id,
    title: project.data.title,
    start_date: project.data.start_date instanceof Date ? project.data.start_date.toISOString().slice(0, 10) : project.data.start_date,
    end_date: project.data.end_date instanceof Date ? project.data.end_date.toISOString().slice(0, 10) : project.data.end_date,
    people: project.data.people || [],
    tags: project.data.tags || [],
    repo: project.data.repo,
    detailUrl: `/en/projects/${project.id}`
  }));
---

<BaseLayout title="Lab Website" description="Welcome to our research lab" lang="en">
  <HomePage client:load lang="en" news={newsItems} projects={featuredProjects} />
</BaseLayout>

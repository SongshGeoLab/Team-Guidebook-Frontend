---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { NewsPage } from '../../../components/react/pages/NewsPage';
import { getGiscusConfig } from '../../../config/giscus';

const allNews = await getCollection('news', ({ data }) => data.publish !== false);
const news = allNews
  .sort((a, b) => {
    const dateA = a.data.date instanceof Date ? a.data.date : new Date(a.data.date);
    const dateB = b.data.date instanceof Date ? b.data.date : new Date(b.data.date);
    return dateB.getTime() - dateA.getTime();
  })
  .map((item) => ({
    id: item.id,
    title: item.data.title || item.id,
    date: (item.data.date instanceof Date ? item.data.date : new Date(item.data.date)).toISOString(),
    content: item.data.content || '',
    tags: item.data.tags || [],
    related_people: item.data.related_people || []
  }));

// Get Giscus configuration
const giscusConfig = getGiscusConfig();
---

<BaseLayout title="News" description="Lab news and updates" lang="en">
  <NewsPage client:load lang="en" news={news} giscusConfig={giscusConfig} />
</BaseLayout>


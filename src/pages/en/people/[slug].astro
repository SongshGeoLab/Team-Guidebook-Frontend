---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const people = await getCollection('people', ({ data }) => data.publish !== false);
  return people.map((person) => ({
    params: { slug: person.id },
    props: { person },
  }));
}

const { person } = Astro.props;
const { Content } = await person.render();
---

<BaseLayout title={person.data.name} description={`${person.data.name} - ${person.data.role}`} lang="en">
  <article class="prose dark:prose-invert max-w-none">
    <div class="flex items-start gap-6 mb-8 pb-8 border-b border-gray-200 dark:border-gray-700">
      {person.data.avatar ? (
        <img
          src={person.data.avatar}
          alt={person.data.name}
          class="w-32 h-32 rounded-full object-cover flex-shrink-0"
        />
      ) : (
        <div class="w-32 h-32 rounded-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center text-4xl text-gray-500 dark:text-gray-400 flex-shrink-0">
          {person.data.name.charAt(0)}
        </div>
      )}
      <div class="flex-1">
        <h1 class="text-4xl font-bold mb-2">{person.data.name}</h1>
        <p class="text-xl text-gray-600 dark:text-gray-400 mb-4">{person.data.role}</p>
        
        <div class="space-y-2">
          {person.data.email && (
            <p class="text-gray-700 dark:text-gray-300">
              <strong>Email:</strong>
              <a href={`mailto:${person.data.email}`} class="text-blue-600 hover:underline">
                {person.data.email}
              </a>
            </p>
          )}
          
          {person.data.links && person.data.links.length > 0 && (
            <div>
              <strong>Links:</strong>
              <ul class="inline-flex flex-wrap gap-2 ml-2">
                {person.data.links.map((link) => (
                  <li>
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-blue-600 hover:underline"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          
          {person.data.interests && person.data.interests.length > 0 && (
            <div>
              <strong>Research Interests:</strong>
              <span class="ml-2">
                {person.data.interests.join(', ')}
              </span>
            </div>
          )}
        </div>
      </div>
    </div>
    
    <div class="mt-8">
      <Content />
    </div>
  </article>
</BaseLayout>



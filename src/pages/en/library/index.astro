---
import { getCollection } from 'astro:content';
import { getLibraryEntries } from '../../../utils/libraryEntries';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LibraryPage } from '../../../components/react/pages/LibraryPage';

const allLibrary = await getLibraryEntries();
const items = allLibrary.map((item) => {
  const parts = item.id
    .replace(/\.md$/, '')
    .split('/')
    .filter((p) => p);
  const slug = parts.join('/');

  return {
    id: item.id,
    slug,
    title: item.data.title || parts[parts.length - 1] || item.id,
    date: item.data.date ? (item.data.date instanceof Date ? item.data.date.toISOString().slice(0, 10) : String(item.data.date)) : undefined,
    description: String(item.data.description || item.data.excerpt || ''),
    tags: item.data.tags || [],
    detailUrl: `/en/library/${slug}`
  };
});
---

<BaseLayout title="Library" description="Knowledge base" lang="en">
  <LibraryPage client:visible lang="en" items={items} />
</BaseLayout>



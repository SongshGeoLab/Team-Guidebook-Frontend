---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { PublicationsPage } from '../../../components/react/pages/PublicationsPage';
import { LOCALES, ui, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;

const allPubs = await getCollection('publications', ({ data }) => data.publish !== false);
const publications = allPubs.map((pub) => ({
  id: pub.id,
  title: pub.data.title || pub.id,
  authors: pub.data.authors || [],
  venue: pub.data.venue,
  // Number(undefined) is NaN, and `{NaN && ...}` renders the literal string
  // "NaN" — React only skips `false`/`null`/`undefined`. Keep it undefined.
  year: typeof pub.data.year === 'number' ? pub.data.year : undefined,
  tags: pub.data.tags || [],
  url: pub.data.pdf || pub.data.doi,
  bibtex: pub.data.bibtex
}));
---

<BaseLayout title={ui.publications.title[lang]} description={ui.publications.description[lang]} lang={lang}>
  <PublicationsPage client:load lang={lang} publications={publications} />
</BaseLayout>


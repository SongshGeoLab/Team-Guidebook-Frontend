---
import { getCollection , render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LOCALES, ui, type Lang } from '../../../i18n/ui';
import { formatDay } from '../../../utils/formatDate';
import { entrySlug } from '../../../utils/entrySlug';
import { pickLocalized, translationIndex } from '../../../utils/localized';
import { COLLECTION_VAULT_PATHS } from '../../../utils/contentLayout.js';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => data.publish !== false);
  const translations = await getCollection('translations', ({ data }) => data.publish !== false);

  return LOCALES.flatMap((lang) => {
    const overlays = translationIndex(translations, COLLECTION_VAULT_PATHS.projects, lang);
    return projects.map((project) => ({
      params: { lang, slug: entrySlug(project) },
      props: { project, overlay: overlays.get(project.id) },
    }));
  });
}

const lang = Astro.params.lang as Lang;
const { project, overlay } = Astro.props;

// English body from a `<name>.en.md` sibling; the Chinese original with a
// notice when there is none.
const { Content } = await render(overlay ?? project);
const isFallback = lang !== 'zh' && !overlay;

const title = pickLocalized(project.data, 'title', lang) ?? project.data.title;
const summary = pickLocalized(project.data, 'summary', lang);

// Get all people for name lookup
const allPeople = await getCollection('people', ({ data }) => data.publish !== false);
// Projects reference people by their frontmatter `id`, while the collection id
// is the filename. Key the map by both (plus the slug) so a reference resolves
// whichever form the author used.
const peopleMap = new Map(
  allPeople.flatMap((p) => {
    const entry = { name: pickLocalized(p.data, 'name', lang) ?? p.data.name, slug: entrySlug(p) };
    return [p.data.id, p.id, entry.slug]
      .filter(Boolean)
      .map((key) => [key, entry] as const);
  })
);

const startDate = project.data.start_date instanceof Date 
  ? project.data.start_date 
  : new Date(project.data.start_date);
const endDate = project.data.end_date 
  ? (project.data.end_date instanceof Date ? project.data.end_date : new Date(project.data.end_date))
  : null;
---

<BaseLayout title={title} description={summary ?? title} lang={lang}>
  <article class="prose dark:prose-invert max-w-none">
    <h1>{title}</h1>
    {summary && <p class="lead">{summary}</p>}
    
    <div class="mt-6 p-6 bg-gray-50 dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
      <dl class="grid md:grid-cols-2 gap-4">
        <div>
          <dt class="font-semibold text-gray-700 dark:text-gray-300">{ui.project.duration[lang]}</dt>
          <dd class="text-gray-600 dark:text-gray-400">
            {formatDay(startDate, lang)}
            {endDate 
              ? ` - ${formatDay(endDate, lang)}`
              : ` - ${ui.project.present[lang]}`}
          </dd>
        </div>
        
        {project.data.people && project.data.people.length > 0 && (
          <div>
            <dt class="font-semibold text-gray-700 dark:text-gray-300">{ui.project.participants[lang]}</dt>
            <dd class="text-gray-600 dark:text-gray-400">
              <ul class="list-none p-0 m-0">
                {project.data.people.map((personId) => {
                  const person = peopleMap.get(personId);
                  return person ? (
                    <li>
                      <a 
                        href={`/${lang}/people/${person.slug}`}
                        class="text-blue-600 hover:underline"
                      >
                        {person.name}
                      </a>
                    </li>
                  ) : (
                    <li>{personId}</li>
                  );
                })}
              </ul>
            </dd>
          </div>
        )}
        
        {project.data.repo && (
          <div>
            <dt class="font-semibold text-gray-700 dark:text-gray-300">{ui.project.repository[lang]}</dt>
            <dd class="text-gray-600 dark:text-gray-400">
              <a 
                href={project.data.repo}
                target="_blank"
                rel="noopener noreferrer"
                class="text-blue-600 hover:underline"
              >
                {project.data.repo}
              </a>
            </dd>
          </div>
        )}
        
        {project.data.tags && project.data.tags.length > 0 && (
          <div>
            <dt class="font-semibold text-gray-700 dark:text-gray-300">{ui.project.tags[lang]}</dt>
            <dd class="text-gray-600 dark:text-gray-400">
              <div class="flex flex-wrap gap-2">
                {project.data.tags.map((tag) => (
                  <span class="px-2 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded text-sm">
                    {tag}
                  </span>
                ))}
              </div>
            </dd>
          </div>
        )}
      </dl>
    </div>
    
    {
      isFallback && (
        <p class="not-prose mt-8 rounded-lg border border-amber-500/30 bg-amber-500/10 px-4 py-2 text-sm text-amber-800 dark:text-amber-200">
          {ui.i18n.fallbackNotice[lang]}
        </p>
      )
    }

    <div class="mt-8">
      <Content />
    </div>
  </article>
</BaseLayout>



---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { NewsPage } from '../../../components/react/pages/NewsPage';
import { getGiscusConfig } from '../../../config/giscus';
import { entrySlug } from '../../../utils/entrySlug';
import { LOCALES, ui, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;

const allNews = await getCollection('news', ({ data }) => data.publish !== false);

// related_people holds person ids. Resolve them to names + URLs here so the
// timeline can actually render them; the field used to be threaded all the way
// through to the component and then never displayed.
const allPeople = await getCollection('people', ({ data }) => data.publish !== false);
const peopleById = new Map(allPeople.map((p) => [entrySlug(p), { name: p.data.name, slug: entrySlug(p) }]));
const news = allNews
  .sort((a, b) => {
    const dateA = a.data.date instanceof Date ? a.data.date : new Date(a.data.date);
    const dateB = b.data.date instanceof Date ? b.data.date : new Date(b.data.date);
    return dateB.getTime() - dateA.getTime();
  })
  .map((item) => ({
    id: item.id,
    title: item.data.title || item.id,
    date: (item.data.date instanceof Date ? item.data.date : new Date(item.data.date)).toISOString(),
    content: item.data.content || '',
    tags: item.data.tags || [],
    related_people: item.data.related_people || [],
    // flatMap, not map+filter(Boolean)+map: `filter(Boolean)` does not narrow
    // `T | undefined` away in TypeScript, which is the only reason this had to
    // fall back to `any` and discard a type Astro already knows.
    relatedPeople: (item.data.related_people || []).flatMap((id: string) => {
      const person = peopleById.get(id);
      return person ? [{ name: person.name, url: `/${lang}/people/${person.slug}` }] : [];
    })
  }));

// Get Giscus configuration
const giscusConfig = getGiscusConfig();
---

<BaseLayout title={ui.news.title[lang]} description={ui.news.description[lang]} lang={lang}>
  <NewsPage client:load lang={lang} news={news} giscusConfig={giscusConfig} />
</BaseLayout>


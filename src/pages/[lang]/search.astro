---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SearchPage } from '../../components/react/pages/SearchPage';
import { LOCALES, ui, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<BaseLayout title={ui.search.title[lang]} description={ui.search.description[lang]} lang={lang}>
  <SearchPage client:load lang={lang} />
</BaseLayout>

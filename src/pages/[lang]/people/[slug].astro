---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LOCALES, ui, type Lang } from '../../../i18n/ui';
import { entrySlug } from '../../../utils/entrySlug';
import { pickLocalized, pickLocalizedList, translationIndex } from '../../../utils/localized';
import { COLLECTION_VAULT_PATHS } from '../../../utils/contentLayout.js';
import { ROLE_TITLES, normalizeRole } from '../../../utils/roles';

export async function getStaticPaths() {
  const people = await getCollection('people', ({ data }) => data.publish !== false);
  const translations = await getCollection('translations', ({ data }) => data.publish !== false);

  return LOCALES.flatMap((lang) => {
    // Built per locale: which body a page renders depends on the locale, so the
    // pairing cannot be hoisted out of this loop.
    const overlays = translationIndex(translations, COLLECTION_VAULT_PATHS.people, lang);
    return people.map((person) => ({
      params: { lang, slug: entrySlug(person) },
      props: { person, overlay: overlays.get(person.id) },
    }));
  });
}

const lang = Astro.params.lang as Lang;
const { person, overlay } = Astro.props;

// The English body lives in a `<name>.en.md` sibling. When there is none the
// reader gets the Chinese with a notice — never a blank page, which is what an
// empty-state would have produced for most of the vault.
const { Content } = await render(overlay ?? person);
const isFallback = lang !== 'zh' && !overlay;

const name = pickLocalized(person.data, 'name', lang) ?? person.data.name;
const title = pickLocalized(person.data, 'title', lang) ?? ROLE_TITLES[normalizeRole(person.data.role)][lang];
const destination = pickLocalized(person.data, 'destination', lang);
const interests = pickLocalizedList(person.data, 'interests', lang);
// '、' is a Chinese enumeration comma; an English list wants ', '.
const interestSeparator = lang === 'zh' ? '、' : ', ';
---

<BaseLayout title={name} description={`${name} - ${title}`} lang={lang}>
  <article class="prose dark:prose-invert max-w-none">
    <div class="flex items-start gap-6 mb-8 pb-8 border-b border-gray-200 dark:border-gray-700">
      {person.data.avatar ? (
        <img
          src={person.data.avatar}
          alt=""
          width="128"
          height="128"
          loading="lazy"
          decoding="async"
          class="w-32 h-32 rounded-full object-cover flex-shrink-0"
        />
      ) : (
        <div aria-hidden="true" class="w-32 h-32 rounded-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center text-4xl text-gray-500 dark:text-gray-400 flex-shrink-0">
          {name.charAt(0)}
        </div>
      )}
      <div class="flex-1">
        <h1 class="text-4xl font-bold mb-2">{name}</h1>
        <p class="text-xl text-gray-600 dark:text-gray-400 mb-4">{title}</p>

        <div class="space-y-2">
          {destination && (
            <p class="text-gray-700 dark:text-gray-300">
              <strong>{ui.person.destination[lang]}</strong>
              <span class="ml-2">{destination}</span>
            </p>
          )}

          {person.data.email && (
            <p class="text-gray-700 dark:text-gray-300">
              <strong>{ui.person.email[lang]}</strong>
              <a href={`mailto:${person.data.email}`} class="text-blue-600 hover:underline">
                {person.data.email}
              </a>
            </p>
          )}

          {person.data.links && person.data.links.length > 0 && (
            <div>
              <strong>{ui.person.links[lang]}</strong>
              <ul class="inline-flex flex-wrap gap-2 ml-2">
                {person.data.links.map((link) => (
                  <li>
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-blue-600 hover:underline"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {interests.length > 0 && (
            <div>
              <strong>{ui.person.interests[lang]}</strong>
              <span class="ml-2">{interests.join(interestSeparator)}</span>
            </div>
          )}
        </div>
      </div>
    </div>

    {
      isFallback && (
        <p class="not-prose mb-6 rounded-lg border border-amber-500/30 bg-amber-500/10 px-4 py-2 text-sm text-amber-200">
          {ui.i18n.fallbackNotice[lang]}
        </p>
      )
    }

    <div class="mt-8">
      <Content />
    </div>
  </article>
</BaseLayout>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LOCALES, ui, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<BaseLayout title={ui.about.title[lang]} description={ui.about.description[lang]} lang={lang}>
  <div class="prose dark:prose-invert max-w-none">
    <h1>{ui.about.heading[lang]}</h1>
    <p class="lead">{ui.about.lead[lang]}</p>
    <p class="text-sm text-gray-500 dark:text-gray-400">{ui.about.note[lang]}</p>
  </div>
</BaseLayout>

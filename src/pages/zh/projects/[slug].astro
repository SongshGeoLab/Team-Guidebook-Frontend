---
import { getCollection , render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { entrySlug } from '../../../utils/entrySlug';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => data.publish !== false);
  return projects.map((project) => ({
    params: { slug: entrySlug(project) },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

// Get all people for name lookup
const allPeople = await getCollection('people', ({ data }) => data.publish !== false);
// Projects reference people by their frontmatter `id`, while the collection id
// is the filename. Key the map by both (plus the slug) so a reference resolves
// whichever form the author used.
const peopleMap = new Map(
  allPeople.flatMap((p) => {
    const entry = { name: p.data.name, slug: entrySlug(p) };
    return [p.data.id, p.id, entry.slug]
      .filter(Boolean)
      .map((key) => [key, entry] as const);
  })
);

const startDate = project.data.start_date instanceof Date 
  ? project.data.start_date 
  : new Date(project.data.start_date);
const endDate = project.data.end_date 
  ? (project.data.end_date instanceof Date ? project.data.end_date : new Date(project.data.end_date))
  : null;
---

<BaseLayout title={project.data.title} description={project.data.title} lang="zh">
  <article class="prose dark:prose-invert max-w-none">
    <h1>{project.data.title}</h1>
    
    <div class="mt-6 p-6 bg-gray-50 dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
      <dl class="grid md:grid-cols-2 gap-4">
        <div>
          <dt class="font-semibold text-gray-700 dark:text-gray-300">项目时间</dt>
          <dd class="text-gray-600 dark:text-gray-400">
            {startDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
            {endDate 
              ? ` - ${endDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}`
              : ' - 至今'}
          </dd>
        </div>
        
        {project.data.people && project.data.people.length > 0 && (
          <div>
            <dt class="font-semibold text-gray-700 dark:text-gray-300">参与人员</dt>
            <dd class="text-gray-600 dark:text-gray-400">
              <ul class="list-none p-0 m-0">
                {project.data.people.map((personId) => {
                  const person = peopleMap.get(personId);
                  return person ? (
                    <li>
                      <a 
                        href={`/zh/people/${person.slug}`}
                        class="text-blue-600 hover:underline"
                      >
                        {person.name}
                      </a>
                    </li>
                  ) : (
                    <li>{personId}</li>
                  );
                })}
              </ul>
            </dd>
          </div>
        )}
        
        {project.data.repo && (
          <div>
            <dt class="font-semibold text-gray-700 dark:text-gray-300">代码仓库</dt>
            <dd class="text-gray-600 dark:text-gray-400">
              <a 
                href={project.data.repo}
                target="_blank"
                rel="noopener noreferrer"
                class="text-blue-600 hover:underline"
              >
                {project.data.repo}
              </a>
            </dd>
          </div>
        )}
        
        {project.data.tags && project.data.tags.length > 0 && (
          <div>
            <dt class="font-semibold text-gray-700 dark:text-gray-300">标签</dt>
            <dd class="text-gray-600 dark:text-gray-400">
              <div class="flex flex-wrap gap-2">
                {project.data.tags.map((tag) => (
                  <span class="px-2 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded text-sm">
                    {tag}
                  </span>
                ))}
              </div>
            </dd>
          </div>
        )}
      </dl>
    </div>
    
    <div class="mt-8">
      <Content />
    </div>
  </article>
</BaseLayout>



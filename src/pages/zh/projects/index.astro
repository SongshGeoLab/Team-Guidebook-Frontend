---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ProjectsPage } from '../../../components/react/pages/ProjectsPage';

const allProjects = await getCollection('projects', ({ data }) => data.publish !== false);
const allPeople = await getCollection('people', ({ data }) => data.publish !== false);

const people = allPeople.map((p) => ({
  id: p.id,
  name: p.data.name,
  role: p.data.role,
  avatar: p.data.avatar
}));

const projects = allProjects
  .sort((a, b) => {
    const dateA = a.data.start_date instanceof Date ? a.data.start_date : new Date(a.data.start_date);
    const dateB = b.data.start_date instanceof Date ? b.data.start_date : new Date(b.data.start_date);
    return dateB.getTime() - dateA.getTime();
  })
  .map((project) => ({
    id: project.id,
    title: project.data.title,
    start_date: project.data.start_date instanceof Date ? project.data.start_date.toISOString().slice(0, 10) : project.data.start_date,
    end_date: project.data.end_date instanceof Date ? project.data.end_date.toISOString().slice(0, 10) : project.data.end_date,
    people: project.data.people || [],
    tags: project.data.tags || [],
    repo: project.data.repo,
    detailUrl: `/zh/projects/${project.id}`
  }));
---

<BaseLayout title="项目" description="实验室项目列表" lang="zh">
  <ProjectsPage client:load lang="zh" projects={projects} people={people} />
</BaseLayout>


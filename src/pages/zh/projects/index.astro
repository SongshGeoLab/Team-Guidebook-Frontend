---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

// Get all projects, filtered by publish status
const allProjects = await getCollection('projects', ({ data }) => data.publish !== false);

// Get all people for name lookup
const allPeople = await getCollection('people', ({ data }) => data.publish !== false);
const peopleMap = new Map(allPeople.map((p) => [p.id, p.data.name]));

// Sort projects by start_date (newest first)
const sortedProjects = allProjects.sort((a, b) => {
  const dateA = a.data.start_date instanceof Date ? a.data.start_date : new Date(a.data.start_date);
  const dateB = b.data.start_date instanceof Date ? b.data.start_date : new Date(b.data.start_date);
  return dateB.getTime() - dateA.getTime();
});
---

<BaseLayout title="项目" description="实验室项目列表" lang="zh">
  <div class="prose dark:prose-invert max-w-none">
    <h1>项目</h1>
    <p class="lead">我们正在进行的研究项目。</p>
    
    {sortedProjects.length > 0 ? (
      <div class="grid md:grid-cols-2 gap-6 mt-8">
        {sortedProjects.map((project) => {
          const startDate = project.data.start_date instanceof Date 
            ? project.data.start_date 
            : new Date(project.data.start_date);
          const endDate = project.data.end_date 
            ? (project.data.end_date instanceof Date ? project.data.end_date : new Date(project.data.end_date))
            : null;
          
          return (
            <a
              href={`/zh/projects/${project.id}`}
              class="p-6 border rounded-lg dark:border-gray-700 hover:border-blue-500 dark:hover:border-blue-400 transition-colors block"
            >
              <h2 class="text-xl font-bold mb-2">{project.data.title}</h2>
              <div class="text-sm text-gray-600 dark:text-gray-400 mb-3">
                {startDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long' })}
                {endDate 
                  ? ` - ${endDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long' })}`
                  : ' - 至今'}
              </div>
              
              {project.data.people && project.data.people.length > 0 && (
                <div class="text-sm text-gray-600 dark:text-gray-400 mb-2">
                  <strong>参与人员：</strong>
                  {project.data.people.map((personId) => peopleMap.get(personId) || personId).join('、')}
                </div>
              )}
              
              {project.data.tags && project.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-2 mt-3">
                  {project.data.tags.map((tag) => (
                    <span class="px-2 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded text-xs">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
              
              {project.data.repo && (
                <div class="mt-3 text-sm">
                  <span class="text-blue-600 hover:underline">查看代码仓库 →</span>
                </div>
              )}
            </a>
          );
        })}
      </div>
    ) : (
      <p class="text-gray-500 dark:text-gray-400 mt-8">暂无项目</p>
    )}
  </div>
</BaseLayout>


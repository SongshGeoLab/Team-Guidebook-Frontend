---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { PublicationsPage } from '../../../components/react/pages/PublicationsPage';

const allPubs = await getCollection('publications', ({ data }) => data.publish !== false);
const publications = allPubs.map((pub) => ({
  id: pub.id,
  title: pub.data.title || pub.id,
  authors: pub.data.authors || [],
  venue: pub.data.venue,
  year: typeof pub.data.year === 'number' ? pub.data.year : Number(pub.data.year),
  tags: pub.data.tags || [],
  url: pub.data.pdf || pub.data.doi,
  bibtex: pub.data.bibtex
}));
---

<BaseLayout title="出版物" description="论文与出版物列表" lang="zh">
  <PublicationsPage client:load lang="zh" publications={publications} />
</BaseLayout>


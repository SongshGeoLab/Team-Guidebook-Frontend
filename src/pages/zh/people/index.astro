---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { PeoplePage } from '../../../components/react/pages/PeoplePage';

const allPeople = await getCollection('people', ({ data }) => data.publish !== false);
const people = allPeople.map((person) => ({
  id: person.id,
  name: person.data.name,
  role: person.data.role,
  avatar: person.data.avatar,
  email: person.data.email,
  interests: person.data.interests || [],
  links: person.data.links || [],
  detailUrl: `/zh/people/${person.id}`
}));
---

<BaseLayout title="团队成员" description="实验室成员列表" lang="zh">
  <PeoplePage client:load lang="zh" people={people} />
</BaseLayout>


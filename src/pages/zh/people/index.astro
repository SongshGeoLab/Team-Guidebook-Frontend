---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

// Get all people, filtered by publish status
const allPeople = await getCollection('people', ({ data }) => data.publish !== false);

// Group people by role
const roleGroups: Record<string, typeof allPeople> = {};
allPeople.forEach((person) => {
  const role = person.data.role || '其他';
  if (!roleGroups[role]) {
    roleGroups[role] = [];
  }
  roleGroups[role].push(person);
});

// Sort roles by priority (Professor > Postdoc > PhD > Master > Alumni > Others)
const rolePriority: Record<string, number> = {
  '教授': 1,
  'Professor': 1,
  '博士后': 2,
  'Postdoc': 2,
  '博士生': 3,
  'PhD Student': 3,
  '硕士生': 4,
  'Master Student': 4,
  '校友': 5,
  'Alumni': 5,
};

const sortedRoles = Object.keys(roleGroups).sort((a, b) => {
  const priorityA = rolePriority[a] || 999;
  const priorityB = rolePriority[b] || 999;
  return priorityA - priorityB;
});
---

<BaseLayout title="团队成员" description="实验室成员列表" lang="zh">
  <div class="prose dark:prose-invert max-w-none">
    <h1>团队成员</h1>
    <p class="lead">我们的研究团队由来自不同背景的成员组成。</p>
    
    {sortedRoles.length > 0 ? (
      <div class="space-y-8 mt-8">
        {sortedRoles.map((role) => {
          const people = roleGroups[role];
          return (
            <section key={role}>
              <h2 class="text-2xl font-bold mb-4 border-b border-gray-200 dark:border-gray-700 pb-2">
                {role}
              </h2>
              <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                {people.map((person) => (
                  <a
                    href={`/zh/people/${person.id}`}
                    class="p-4 border rounded-lg dark:border-gray-700 hover:border-blue-500 dark:hover:border-blue-400 transition-colors"
                  >
                    <div class="flex items-start gap-4">
                      {person.data.avatar ? (
                        <img
                          src={person.data.avatar}
                          alt={person.data.name}
                          class="w-16 h-16 rounded-full object-cover"
                        />
                      ) : (
                        <div class="w-16 h-16 rounded-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center text-gray-500 dark:text-gray-400">
                          {person.data.name.charAt(0)}
                        </div>
                      )}
                      <div class="flex-1">
                        <h3 class="font-semibold text-lg">{person.data.name}</h3>
                        <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
                          {person.data.role}
                        </p>
                        {person.data.email && (
                          <p class="text-sm text-gray-500 dark:text-gray-500 mt-1">
                            {person.data.email}
                          </p>
                        )}
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </section>
          );
        })}
      </div>
    ) : (
      <p class="text-gray-500 dark:text-gray-400 mt-8">暂无成员信息</p>
    )}
  </div>
</BaseLayout>

